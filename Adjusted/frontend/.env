# Wave Frontend — Vite environment variables
# Vite only exposes variables that start with VITE_

# ── Backend API URL ─────────────────────────────────────
# Development (your local machine)
VITE_API_URL=http://localhost:4000/api

# ── For production ──────────────────────────────────────
# Uncomment and set your real server URL when deploying:
# VITE_API_URL=https://your-server.com/api
