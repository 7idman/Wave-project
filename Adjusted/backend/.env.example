# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_string_min_32_chars
SESSION_SECRET=replace_with_another_long_random_string

# ── libSQL / Turso database ────────────────────────────────────────────────────
# Option A: Local SQLite file (no Turso account needed — great for development)
LIBSQL_URL=file:wave.db

# Option B: Turso cloud database (for production)
# Sign up free at https://turso.tech, create a database, then:
# LIBSQL_URL=libsql://your-db-name-your-org.turso.io
# LIBSQL_AUTH_TOKEN=your_turso_auth_token_here

# ── Frontend origin ────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Google OAuth (optional — only needed if you want Google Sign-In) ──────────
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Server port ────────────────────────────────────────────────────────────────
PORT=4000
