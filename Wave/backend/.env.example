# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Required in production. Generate separate random values (for example:
# `openssl rand -hex 32`) and never commit the real values.
JWT_SECRET=
SESSION_SECRET=

# Database: use file:wave.db locally or a libsql:// URL with its auth token.
LIBSQL_URL=file:wave.db
LIBSQL_AUTH_TOKEN=

# Account ownership and OAuth
OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Market data and bot protection
FINNHUB_API_KEY=
# Optional pacing controls. Defaults stay below the free-tier request window
# and wait just over a minute before retrying an HTTP 429 response.
FINNHUB_REQUEST_INTERVAL_MS=1100
FINNHUB_RATE_LIMIT_COOLDOWN_MS=61000
COINGECKO_API_KEY=
TURNSTILE_SECRET_KEY=

# Email, phone verification, and push notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=Wave <onboarding@resend.dev>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Deposit destinations. Configure only methods you actually support.
DEPOSIT_PAYPAL_EMAIL=
DEPOSIT_PAYPAL_INSTRUCTIONS=
DEPOSIT_WALLET_BTC=
DEPOSIT_WALLET_ETH=
DEPOSIT_WALLET_SOL=
DEPOSIT_WALLET_USDC=
DEPOSIT_WALLET_USDT=
DEPOSIT_BANK_NAME=
DEPOSIT_BANK_ACCOUNT_NAME=
DEPOSIT_BANK_ACCOUNT_NUMBER=
DEPOSIT_BANK_ROUTING_NUMBER=
DEPOSIT_BANK_IBAN=
DEPOSIT_BANK_SWIFT=
DEPOSIT_BANK_INSTRUCTIONS=

# Optional security tuning (shown with application defaults)
DEVICE_TRUST_DAYS=60
EMAIL_VERIFY_TTL_MINUTES=60
SIGNUP_PHONE_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_HARD_LIMIT=10
LOGIN_WINDOW_MINUTES=15
OTP_SEND_MAX=5
OTP_VERIFY_MAX=5
OTP_WINDOW_MINUTES=30
SENSITIVE_CHANGE_COOLDOWN_HOURS=72
TRANSFER_VERIFICATION_THRESHOLD=500
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60
